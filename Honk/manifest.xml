<?xml version="1.0" encoding="UTF-8"?>
<!--
    Manifiesto de la esfera de reloj (watch face) para Garmin Epix Pro 51 mm (Gen 2).
    Dispositivo objetivo: epix2pro51mm  (pantalla AMOLED redonda de 454 x 454 px).
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="EpixWatchFaceApp"
        id="57df224191fe485f8c919d3f862e8716"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.3.0"
        name="@Strings.AppName"
        type="watchface">

        <!-- Solo compilamos para el Epix Pro 51 mm. -->
        <iq:products>
            <iq:product id="epix2pro51mm"/>
        </iq:products>

        <!-- No se necesitan permisos: la esfera solo usa hora, fecha y batería. -->
        <iq:permissions/>

        <!-- Idiomas soportados. -->
        <iq:languages>
            <iq:language>spa</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
