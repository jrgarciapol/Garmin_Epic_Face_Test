<?xml version="1.0" encoding="UTF-8"?>
<!--
    Manifiesto de la esfera de reloj (watch face) para Garmin Epix Pro 51 mm (Gen 2).
    Dispositivo objetivo: epix2pro51mm  (pantalla AMOLED redonda de 454 x 454 px).
-->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <iq:application
        entry="EpixWatchFaceApp"
        id="98d45fbfc295486d86f16dad64751a66"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.3.0"
        name="@Strings.AppName"
        type="watchface">

        <!-- Solo compilamos para el Epix Pro 51 mm. -->
        <iq:products>
            <iq:product id="epix2pro51mm"/>
        </iq:products>

        <!--
            Una esfera NO puede pedir el permiso 'Sensor' (solo lo admiten las
            apps y widgets, o una esfera con 'Background'). Para el pulso usamos
            el histórico del sensor, que sí es válido para type="watchface".
        -->
        <iq:permissions>
            <iq:uses-permission id="SensorHistory"/>
        </iq:permissions>

        <!-- Idiomas soportados. -->
        <iq:languages>
            <iq:language>spa</iq:language>
            <iq:language>eng</iq:language>
        </iq:languages>
    </iq:application>
</iq:manifest>
